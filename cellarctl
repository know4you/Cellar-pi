#!/usr/bin/env bash

set -u
set -o pipefail

WHIPTAIL="/usr/bin/whiptail"
SUDO="/usr/bin/sudo"
SYSTEMCTL="/usr/bin/systemctl"
JOURNALCTL="/usr/bin/journalctl"
TAIL="/usr/bin/tail"
SED="/usr/bin/sed"
WC="/usr/bin/wc"
GREP="/usr/bin/grep"
I2CDETECT="/usr/sbin/i2cdetect"
PYTHON="/opt/cellar-pi/venv/bin/python"
CONFIG_TOOL="/opt/cellar-pi/cellar_config.py"
LOGGER_TOOL="/opt/cellar-pi/cellar_logger.py"
REPORT_TOOL="/opt/cellar-pi/daily_report.py"
SETUP="/opt/cellar-pi/setup.sh"
UPDATE_TOOL="/usr/local/bin/cellar-update"
CSV="/var/lib/cellar-pi/cellar_readings.csv"
LOGGER="cellar-logger.service"
REPORT_TIMER="cellar-report.timer"


message() {
    "$WHIPTAIL" --title "$1" --msgbox "$2" "${3:-12}" "${4:-70}"
}


please_wait() {
    "$WHIPTAIL" --title "$1" \
        --infobox "Please wait while I get that for you...\n\nElapsed time: 0 seconds." \
        11 62
}


wait_countdown() {
    local title="$1"
    local detail="$2"
    local seconds="$3"
    local remaining progress
    (
        for ((remaining = seconds; remaining > 0; remaining--)); do
            progress=$(((seconds - remaining) * 100 / seconds))
            echo "XXX"
            echo "$progress"
            echo "$detail Continuing in $remaining seconds..."
            echo "XXX"
            /usr/bin/sleep 1
        done
        echo 100
    ) | "$WHIPTAIL" --title "$title" \
        --gauge "$detail" 12 70 0
}


wait_for_sensor_health() {
    local title="$1"
    local sensor="$2"
    local since_epoch="$3"
    local seconds="${4:-35}"
    local elapsed progress
    (
        for ((elapsed = 0; elapsed < seconds; elapsed++)); do
            if "$SUDO" "$SYSTEMCTL" is-active --quiet "$LOGGER" &&
               "$SUDO" "$PYTHON" "$LOGGER_TOOL" \
                   --check-health-since "$since_epoch" \
                   --expected-sensor "$sensor"
            then
                echo 100
                exit 0
            fi
            progress=$((elapsed * 100 / seconds))
            echo "XXX"
            echo "$progress"
            echo "Waiting for a valid $sensor reading. Elapsed time: $elapsed seconds."
            echo "XXX"
            /usr/bin/sleep 1
        done
        exit 1
    ) | "$WHIPTAIL" --title "$title" \
        --gauge "Waiting for the new sensor to report a valid reading." \
        12 76 0
}


run_with_elapsed() {
    local title="$1"
    local detail="$2"
    local output="$3"
    shift 3
    local elapsed=0
    local progress

    "$@" >"$output" 2>&1 &
    local command_pid=$!
    (
        while /usr/bin/kill -0 "$command_pid" 2>/dev/null; do
            progress=$((elapsed + 5))
            ((progress > 95)) && progress=95
            echo "XXX"
            echo "$progress"
            echo "$detail Elapsed time: $elapsed seconds."
            echo "XXX"
            /usr/bin/sleep 1
            ((elapsed++))
        done
        echo 100
    ) | "$WHIPTAIL" --title "$title" \
        --gauge "$detail" 12 72 0
    wait "$command_pid"
}


show_file() {
    "$WHIPTAIL" --title "$1" --scrolltext --textbox "$2" 24 90
}


capture_and_show() {
    local title="$1"
    shift
    local output
    output=$(/usr/bin/mktemp)
    run_with_elapsed "$title" \
        "Please wait while I get that for you." "$output" "$@" || true
    show_file "$title" "$output"
    /usr/bin/rm -f "$output"
}


sensor_hardware_check() {
    local scan configured_sensor configured_address
    local found_44="no"
    local found_45="no"

    configured_sensor=$(config_get sensor type unknown)
    configured_address=$(config_get sensor i2c_address unknown)

    echo "Cellar-pi sensor hardware check"
    echo
    echo "Configured sensor: $configured_sensor"
    echo "Configured address: $configured_address"
    echo

    if [[ ! -e /dev/i2c-1 ]]; then
        echo "I2C bus: NOT READY"
        echo
        echo "The Pi cannot see /dev/i2c-1 yet."
        echo "Run Update Cellar-pi, then reboot the Pi and check again."
        return 1
    fi

    echo "I2C bus: ready"
    echo

    if ! scan=$("$SUDO" "$I2CDETECT" -y 1 2>&1); then
        echo "The I2C scan failed:"
        echo "$scan"
        return 1
    fi

    if "$GREP" -Eq '(^|[[:space:]])44([[:space:]]|$)' <<<"$scan"; then
        found_44="yes"
    fi
    if "$GREP" -Eq '(^|[[:space:]])45([[:space:]]|$)' <<<"$scan"; then
        found_45="yes"
    fi

    echo "Supported SHT addresses found:"
    if [[ "$found_44" == "yes" ]]; then
        echo "  0x44 - SHT31, SHT35, SHT41, or SHT45"
    fi
    if [[ "$found_45" == "yes" ]]; then
        echo "  0x45 - SHT31 or SHT35"
    fi
    if [[ "$found_44" == "no" && "$found_45" == "no" ]]; then
        echo "  None"
    fi
    echo

    case "$configured_address" in
        0x44)
            if [[ "$found_44" == "yes" ]]; then
                echo "Configuration match: YES"
            else
                echo "Configuration match: NO - nothing was detected at 0x44"
            fi
            ;;
        0x45)
            if [[ "$found_45" == "yes" ]]; then
                echo "Configuration match: YES"
            else
                echo "Configuration match: NO - nothing was detected at 0x45"
            fi
            ;;
        *)
            echo "Configuration match: UNKNOWN"
            ;;
    esac

    echo
    echo "Raw I2C scan:"
    echo "$scan"
}


config_get() {
    "$SUDO" "$PYTHON" "$CONFIG_TOOL" get "$1" "$2" --fallback "${3:-}"
}


service_is_healthy() {
    "$SUDO" "$SYSTEMCTL" is-active --quiet "$LOGGER"
}


latest_reading() {
    local latest line_count
    [[ -s "$CSV" ]] || return 1
    line_count=$("$WC" -l <"$CSV")
    ((line_count > 1)) || return 1
    latest=$("$TAIL" -n 1 "$CSV")
    [[ "$latest" != timestamp,* ]] || return 1
    /usr/bin/printf "%s" "$latest"
}


rollback_sensor_config() {
    local backup="$1"
    if [[ -n "$backup" ]]; then
        "$SUDO" "$PYTHON" "$CONFIG_TOOL" restore "$backup" >/dev/null 2>&1 || true
        "$SUDO" "$SYSTEMCTL" restart "$LOGGER" >/dev/null 2>&1 || true
    fi
}


current_reading() {
    local latest
    please_wait "Current Reading"
    if latest=$(
        "$SUDO" "$PYTHON" "$LOGGER_TOOL" --show-latest 2>/dev/null
    ); then
        message "Current Reading" "$latest" 12 82
    else
        message "Current Reading" "No readings have been recorded yet."
    fi
}


recent_readings() {
    please_wait "Recent Readings"
    if latest_reading >/dev/null; then
        capture_and_show "Recent Readings" "$TAIL" -n 30 "$CSV"
    else
        message "Recent Readings" "No readings have been recorded yet."
    fi
}


sensor_settings() {
    local sensor current_sensor i2c backup health_started
    current_sensor=$(config_get sensor type SHT31)
    if [[ ! "$current_sensor" =~ ^SHT(31|35|41|45)$ ]]; then
        current_sensor="SHT31"
    fi
    sensor=$("$WHIPTAIL" \
        --title "Sensor Settings" \
        --default-item "$current_sensor" \
        --menu "Choose the SHT sensor:" \
        17 72 6 \
        "SHT31" "SHT31 and SHT31-D" \
        "SHT35" "Higher-accuracy SHT3x family" \
        "SHT41" "Higher-accuracy SHT4x family" \
        "SHT45" "Highest-accuracy SHT4x family" \
        3>&1 1>&2 2>&3) || return

    i2c=$(config_get sensor i2c_address 0x44)
    if [[ "$sensor" == "SHT31" || "$sensor" == "SHT35" ]]; then
        if [[ "$i2c" != "0x44" && "$i2c" != "0x45" ]]; then
            i2c="0x44"
        fi
        i2c=$("$WHIPTAIL" \
            --title "$sensor I2C Address" \
            --default-item "$i2c" \
            --menu "Choose the sensor address:" \
            14 62 4 \
            "0x44" "Default address" \
            "0x45" "Alternate address" \
            3>&1 1>&2 2>&3) || return
    else
        i2c="0x44"
    fi

    "$WHIPTAIL" \
        --title "Confirm Sensor Change" \
        --yesno "Use the $sensor at I2C address $i2c?\n\nDiscord and report settings will not be changed." \
        12 68 || return

    backup=$("$SUDO" "$PYTHON" "$CONFIG_TOOL" \
        set-sensor "$sensor" --i2c "$i2c" 2>/tmp/cellar-config-error)
    if [[ $? -ne 0 ]]; then
        capture_and_show "Sensor Configuration Failed" /usr/bin/cat /tmp/cellar-config-error
        return
    fi

    health_started=$(/usr/bin/date +%s)
    if ! "$SUDO" "$SYSTEMCTL" restart "$LOGGER"; then
        rollback_sensor_config "$backup"
        capture_and_show "Sensor Change Rolled Back" \
            "$SUDO" "$JOURNALCTL" -u "$LOGGER" -n 50 --no-pager
        return
    fi
    if wait_for_sensor_health \
        "Sensor Settings" "$sensor" "$health_started" 35
    then
        message "Sensor Updated" \
            "The new sensor produced a valid reading.\n\nDiscord and report settings were not changed."
    else
        rollback_sensor_config "$backup"
        capture_and_show "Sensor Change Rolled Back" \
            "$SUDO" "$JOURNALCTL" -u "$LOGGER" -n 50 --no-pager
    fi
}


sensor_menu() {
    while true; do
        local choice
        choice=$("$WHIPTAIL" \
            --title "Sensor" \
            --menu "Choose an option:" \
            17 70 6 \
            "1" "Current Reading" \
            "2" "Recent Readings" \
            "3" "Sensor Settings" \
            "0" "Back" \
            3>&1 1>&2 2>&3) || return
        case "$choice" in
            1) current_reading ;;
            2) recent_readings ;;
            3) sensor_settings ;;
            0) return ;;
        esac
    done
}


discord_status() {
    local webhook
    please_wait "Discord Status"
    webhook=$(config_get discord webhook_url)
    if [[ -n "$webhook" ]]; then
        message "Discord Status" "Discord webhook: Configured"
    else
        message "Discord Status" "Discord webhook: Not configured"
    fi
}


discord_settings() {
    while true; do
        local choice webhook
        choice=$("$WHIPTAIL" \
            --title "Discord Settings" \
            --menu "Choose an option:" \
            17 72 6 \
            "1" "Add or Replace Webhook" \
            "2" "Remove Webhook" \
            "3" "View Discord Status" \
            "0" "Back" \
            3>&1 1>&2 2>&3) || return
        case "$choice" in
            1)
                webhook=$("$WHIPTAIL" \
                    --title "Discord Webhook" \
                    --passwordbox "Paste the Discord webhook URL:" \
                    11 78 \
                    3>&1 1>&2 2>&3) || continue
                if "$SUDO" "$PYTHON" "$CONFIG_TOOL" set-discord "$webhook" \
                    >/dev/null 2>/tmp/cellar-config-error
                then
                    message "Discord Settings" \
                        "Webhook saved.\n\nThe logger was not restarted."
                else
                    capture_and_show "Invalid Discord Configuration" \
                        /usr/bin/cat /tmp/cellar-config-error
                fi
                ;;
            2)
                if "$WHIPTAIL" --title "Remove Webhook" \
                    --yesno "Remove the Discord webhook and disable scheduled reports?" \
                    11 70
                then
                    "$SUDO" "$PYTHON" "$CONFIG_TOOL" remove-discord >/dev/null
                    message "Discord Settings" \
                        "Webhook removed and scheduled reports disabled.\n\nLogging was not interrupted."
                fi
                ;;
            3) discord_status ;;
            0) return ;;
        esac
    done
}


test_notification() {
    local output result logger_before logger_after
    output=$(/usr/bin/mktemp)
    logger_before=$("$SUDO" "$SYSTEMCTL" is-active "$LOGGER" 2>/dev/null || true)
    run_with_elapsed "Test Notification" \
        "Sending a Discord test message." "$output" \
        "$SUDO" "$PYTHON" "$REPORT_TOOL" --test-notification
    result=$?
    logger_after=$("$SUDO" "$SYSTEMCTL" is-active "$LOGGER" 2>/dev/null || true)
    /usr/bin/printf \
        "\nLogger before notification test: %s\nLogger after notification test: %s\n" \
        "$logger_before" "$logger_after" >>"$output"
    if [[ "$result" -eq 0 ]]; then
        message "Test Notification" \
            "Discord accepted the test notification.\n\nLogger before: $logger_before\nLogger after: $logger_after"
    else
        show_file "Notification Failed - Logger Unaffected" "$output"
    fi
    /usr/bin/rm -f "$output"
}


schedule_status() {
    local enabled time frequency webhook timer
    please_wait "Schedule Status"
    enabled=$(config_get discord report_enabled false)
    time=$(config_get discord report_time 19:00)
    frequency=$(config_get discord report_frequency_hours 24)
    webhook=$(config_get discord webhook_url)
    timer=$("$SUDO" "$SYSTEMCTL" is-active "$REPORT_TIMER" 2>/dev/null || true)
    [[ -n "$webhook" ]] && webhook="Configured" || webhook="Not configured"
    message "Schedule Status" \
        "Reports enabled: $enabled\nFrequency and graph range: $frequency hours\nFirst report time: $time\nDiscord webhook: $webhook\nReport timer: $timer" \
        15 72
}


send_graph_now() {
    local output result logger_before logger_after
    output=$(/usr/bin/mktemp)
    logger_before=$("$SUDO" "$SYSTEMCTL" is-active "$LOGGER" 2>/dev/null || true)
    run_with_elapsed "Send Graph Now" \
        "Generating and sending the selected report graph." "$output" \
        "$SUDO" "$PYTHON" "$REPORT_TOOL" --test-report
    result=$?
    logger_after=$("$SUDO" "$SYSTEMCTL" is-active "$LOGGER" 2>/dev/null || true)
    /usr/bin/printf \
        "\nLogger before report: %s\nLogger after report: %s\n" \
        "$logger_before" "$logger_after" >>"$output"
    if [[ "$result" -eq 0 ]]; then
        message "Send Graph Now" \
            "The selected report graph was sent to Discord.\n\nThe saved schedule was not changed.\nLogger before: $logger_before\nLogger after: $logger_after"
    else
        show_file "Graph Send Failed - Logger Unaffected" "$output"
    fi
    /usr/bin/rm -f "$output"
}


schedule_settings() {
    while true; do
        local choice report_time report_frequency
        choice=$("$WHIPTAIL" \
            --title "Schedule Settings" \
            --menu "Choose an option:" \
            19 72 8 \
            "1" "Enable Reports" \
            "2" "Disable Reports" \
            "3" "Change Report Time" \
            "4" "Report Frequency and Graph Range" \
            "5" "View Schedule Status" \
            "0" "Back" \
            3>&1 1>&2 2>&3) || return
        case "$choice" in
            1)
                if "$SUDO" "$PYTHON" "$CONFIG_TOOL" \
                    set-report-enabled true >/dev/null 2>/tmp/cellar-config-error
                then
                    message "Schedule Settings" "Scheduled reports enabled."
                else
                    capture_and_show "Cannot Enable Report" \
                        /usr/bin/cat /tmp/cellar-config-error
                fi
                ;;
            2)
                "$SUDO" "$PYTHON" "$CONFIG_TOOL" \
                    set-report-enabled false >/dev/null
                message "Schedule Settings" \
                    "Reports disabled.\n\nThe saved report time and frequency were kept."
                ;;
            3)
                report_time=$("$WHIPTAIL" \
                    --title "Report Time" \
                    --inputbox "Enter a 24-hour time (HH:MM):" \
                    11 62 "$(config_get discord report_time 19:00)" \
                    3>&1 1>&2 2>&3) || continue
                if "$SUDO" "$PYTHON" "$CONFIG_TOOL" \
                    set-report-time "$report_time" >/dev/null 2>/tmp/cellar-config-error
                then
                    message "Schedule Settings" \
                        "Report time changed to $report_time.\n\nReporting was not enabled or disabled."
                else
                    capture_and_show "Invalid Report Time" \
                        /usr/bin/cat /tmp/cellar-config-error
                fi
                ;;
            4)
                report_frequency=$("$WHIPTAIL" \
                    --title "Report Frequency and Graph Range" \
                    --default-item "$(config_get discord report_frequency_hours 24)" \
                    --menu "Choose how often reports send and how much data each graph shows:" \
                    15 78 4 \
                    "24" "Every 24 hours with a 24-hour graph" \
                    "12" "Every 12 hours with a 12-hour graph" \
                    3>&1 1>&2 2>&3) || continue
                if "$SUDO" "$PYTHON" "$CONFIG_TOOL" \
                    set-report-frequency "$report_frequency" \
                    >/dev/null 2>/tmp/cellar-config-error
                then
                    message "Schedule Settings" \
                        "Reports will send every $report_frequency hours with a $report_frequency-hour graph.\n\nThe first report time stays unchanged."
                else
                    capture_and_show "Invalid Report Frequency" \
                        /usr/bin/cat /tmp/cellar-config-error
                fi
                ;;
            5) schedule_status ;;
            0) return ;;
        esac
    done
}


notification_status() {
    schedule_status
}


notifications_menu() {
    while true; do
        local choice
        choice=$("$WHIPTAIL" \
            --title "Notifications" \
            --menu "Choose an option:" \
            19 72 8 \
            "1" "Discord Settings" \
            "2" "Schedule Settings" \
            "3" "Send Graph Now" \
            "4" "Test Notification" \
            "5" "View Notification Status" \
            "0" "Back" \
            3>&1 1>&2 2>&3) || return
        case "$choice" in
            1) discord_settings ;;
            2) schedule_settings ;;
            3) send_graph_now ;;
            4) test_notification ;;
            5) notification_status ;;
            0) return ;;
        esac
    done
}


system_status() {
    local logger timer sensor sensor_health last webhook enabled time frequency
    please_wait "System Status"
    logger=$("$SUDO" "$SYSTEMCTL" is-active "$LOGGER" 2>/dev/null || true)
    timer=$("$SUDO" "$SYSTEMCTL" is-active "$REPORT_TIMER" 2>/dev/null || true)
    sensor=$(config_get sensor type unknown)
    sensor_health=$(
        "$SUDO" "$PYTHON" "$LOGGER_TOOL" --show-status 2>/dev/null ||
            /usr/bin/printf "Sensor health: No status yet"
    )
    webhook=$(config_get discord webhook_url)
    enabled=$(config_get discord report_enabled false)
    time=$(config_get discord report_time 19:00)
    frequency=$(config_get discord report_frequency_hours 24)
    [[ -n "$webhook" ]] && webhook="Configured" || webhook="Not configured"
    if last=$(
        "$SUDO" "$PYTHON" "$LOGGER_TOOL" --show-latest 2>/dev/null
    ); then
        :
    else
        last="No readings yet"
    fi
    message "System Status" \
        "Logger: $logger\nSensor: $sensor\n$sensor_health\nReport timer: $timer\nDiscord: $webhook\nReports: $enabled every $frequency hours\nGraph range: $frequency hours\nFirst report time: $time\n\nLast reading:\n$last" \
        22 84
}


temperature_units() {
    local unit
    unit=$("$WHIPTAIL" \
        --title "Temperature Units" \
        --menu "Choose the display unit:" \
        14 62 4 \
        "fahrenheit" "Fahrenheit (deg F)" \
        "celsius" "Celsius (deg C)" \
        "0" "Back" \
        3>&1 1>&2 2>&3) || return
    [[ "$unit" == "0" ]] && return
    if "$SUDO" "$PYTHON" "$CONFIG_TOOL" \
        set-temperature-unit "$unit" >/dev/null
    then
        message "Temperature Units" \
            "Display unit changed to $unit.\n\nThe logger was not restarted."
    fi
}


service_action() {
    local action="$1"
    if "$WHIPTAIL" --title "$action Logger" \
        --yesno "$action the logger now?" 10 58
    then
        if ! "$SUDO" "$SYSTEMCTL" "${action,,}" "$LOGGER"; then
            capture_and_show "$action Failed" \
                "$SUDO" "$JOURNALCTL" -u "$LOGGER" -n 50 --no-pager
            return
        fi
        wait_countdown "$action Logger" \
            "Waiting for the logger to settle." 2
        if [[ "$action" == "Stop" ]]; then
            if ! service_is_healthy; then
                message "$action Logger" "Logger stopped successfully."
            else
                message "$action Logger" "Logger is still running."
            fi
        elif service_is_healthy; then
            message "$action Logger" "Logger is running."
        else
            capture_and_show "$action Failed" \
                "$SUDO" "$JOURNALCTL" -u "$LOGGER" -n 50 --no-pager
        fi
    fi
}


update_cellar_pi() {
    local output result
    if ! "$WHIPTAIL" --title "Update Cellar-pi" \
        --yesno "Download and install the newest Cellar-pi version?\n\nConfiguration and readings will be preserved. The previous installation is restored if the update fails." \
        14 74
    then
        return
    fi

    output=$(/usr/bin/mktemp)
    run_with_elapsed "Update Cellar-pi" \
        "Downloading, validating, and installing the update." "$output" \
        "$SUDO" "$UPDATE_TOOL"
    result=$?
    if [[ "$result" -eq 0 ]]; then
        show_file "Update Complete - Reopen /uc" "$output"
        /usr/bin/rm -f "$output"
        exit 0
    else
        show_file "Update Failed - Previous Version Restored" "$output"
    fi
    /usr/bin/rm -f "$output"
}


advanced_menu() {
    while true; do
        local choice backup sensor health_started
        choice=$("$WHIPTAIL" \
            --title "Advanced / Troubleshooting" \
            --menu "Choose an option:" \
            25 76 13 \
            "1" "Temperature Units" \
            "2" "View Configuration" \
            "3" "View Logger Status" \
            "4" "View Logger Logs" \
            "5" "Scan Connected Sensors" \
            "6" "Restart Logger" \
            "7" "Stop Logger" \
            "8" "Start Logger" \
            "9" "Repair Python Packages" \
            "10" "Update Cellar-pi" \
            "11" "Run Full Setup Wizard" \
            "0" "Back" \
            3>&1 1>&2 2>&3) || return
        case "$choice" in
            1) temperature_units ;;
            2)
                capture_and_show "Configuration" \
                    "$SUDO" "$PYTHON" "$CONFIG_TOOL" show-sanitized
                ;;
            3)
                capture_and_show "Logger Status" \
                    "$SUDO" "$SYSTEMCTL" status "$LOGGER" --no-pager
                ;;
            4)
                capture_and_show "Logger Logs" \
                    "$SUDO" "$JOURNALCTL" -u "$LOGGER" -n 100 --no-pager
                ;;
            5)
                capture_and_show "Scan Connected Sensors" \
                    sensor_hardware_check
                ;;
            6) service_action "Restart" ;;
            7) service_action "Stop" ;;
            8) service_action "Start" ;;
            9)
                if "$WHIPTAIL" --title "Repair Python Packages" \
                    --yesno "Reinstall the project Python packages?\n\nOnly the exact Cellar-pi repair command is allowed." \
                    12 68
                then
                    capture_and_show "Package Repair" \
                        "$SUDO" "$PYTHON" -m pip install \
                        --requirement /opt/cellar-pi/requirements.txt
                fi
                ;;
            10) update_cellar_pi ;;
            11)
                if "$WHIPTAIL" --title "Full Setup Wizard" \
                    --yesno "Run the full setup wizard?\n\nExisting settings are loaded and the webhook is kept unless you explicitly replace or remove it." \
                    14 72
                then
                    backup=$("$SUDO" "$PYTHON" "$CONFIG_TOOL" backup)
                    if "$SUDO" "$SETUP"; then
                        sensor=$(config_get sensor type unknown)
                        health_started=$(/usr/bin/date +%s)
                        if "$SUDO" "$SYSTEMCTL" restart "$LOGGER" &&
                           wait_for_sensor_health \
                               "Full Setup Wizard" \
                               "$sensor" "$health_started" 35
                        then
                            message "Full Setup Wizard" \
                                "Configuration validated and the sensor produced a valid reading."
                        else
                            rollback_sensor_config "$backup"
                            capture_and_show "Setup Rolled Back" \
                                "$SUDO" "$JOURNALCTL" -u "$LOGGER" -n 50 --no-pager
                        fi
                    fi
                fi
                ;;
            0) return ;;
        esac
    done
}


while true; do
    choice=$("$WHIPTAIL" \
        --title "Cellar-pi User Control" \
        --menu "Choose a section:" \
        18 72 7 \
        "1" "Sensor" \
        "2" "Notifications" \
        "3" "System Status" \
        "4" "Advanced / Troubleshooting" \
        "0" "Exit" \
        3>&1 1>&2 2>&3) || exit 0

    case "$choice" in
        1) sensor_menu ;;
        2) notifications_menu ;;
        3) system_status ;;
        4) advanced_menu ;;
        0) exit 0 ;;
    esac
done
