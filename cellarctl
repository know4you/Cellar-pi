#!/usr/bin/env bash

set -Eeuo pipefail

PYTHON="/opt/cellar-pi/venv/bin/python"
UI="/opt/cellar-pi/cellar_ui.py"

if [[ ! -x "$PYTHON" ]]; then
    echo "Cellar-pi Python environment is missing." >&2
    echo "Run the installer or the repair option from a working installation." >&2
    exit 1
fi

if [[ ! -f "$UI" ]]; then
    echo "Cellar-pi User Control is missing: $UI" >&2
    exit 1
fi

exec "$PYTHON" "$UI"
